# ==============================================================================
# CHOFÈ LEGLIZ — CONFIGURATION ENVIRONMENT VARIABLES (.env.example)
# Kopye fichye sa a kòm `.env.local` pou devlopman lokal.
# PA JANM mete kle reyèl yo nan GitHub.
# ==============================================================================

# Supabase URL & Anon Key (Piblik / Navigatè)
# Jwenn kle sa yo nan: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Key (Sèvè Sèlman - PA JANM ekspoze li nan navigatè a)
# Itilize sèlman pou script administratif oubyen operasyon sèvè ki gen privilèj.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# URL Pwodiksyon oswa Devlopman (Pou Supabase Auth Redirects)
# Lokal: http://localhost:3000
# Vercel / Pwodiksyon: https://chofe-legliz.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
